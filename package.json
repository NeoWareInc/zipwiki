{
  "name": "zipwiki",
  "private": true,
  "version": "0.1.0",
  "description": "ZipWiki \u2014 portable AI-readable document archives",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "pnpm --filter @zipwiki/web dev",
    "build:web": "pnpm --filter @zipwiki/web build"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
