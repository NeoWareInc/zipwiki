# ZipWiki Convex — production deployment (festive-hare-381).
# Copy to deploy/.env.convex.prod and fill the empty values. Do not commit that file.
#
# Leave JWT_PRIVATE_KEY and JWKS unset here. `npx @convex-dev/auth` creates them.
# Do not set CONVEX_SITE_URL. Convex provides it.
# ZIPWIKI_WORKER_SECRET must match the Fly prod secret.
# The webhook name the code reads is STRIPE_WEBHOOK_SECRET.

SITE_URL=https://www.zipwiki.ai
WEB_ORIGIN=https://www.zipwiki.ai,https://zipwiki.ai
# Open beta with a hard account cap (default 500 when unset).
BETA_ACCESS_MODE=open
BETA_USER_LIMIT=500
AUTH_EMAIL="ZipWiki <noreply@zipwiki.ai>"
AUTH_ADMIN_EMAILS=steve@neoware.io,admin@neoware.io
AUTH_RESEND_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZIPWIKI_WORKER_SECRET=
ZIPWIKI_API_URL=https://api.zipwiki.ai
