# ZipWiki Convex — dev deployment (dashing-cod-224).
# Copy to deploy/.env.convex.dev and fill the empty values. Do not commit that file.
#
# Leave JWT_PRIVATE_KEY and JWKS unset here. `npx @convex-dev/auth` creates them.
# Do not set CONVEX_SITE_URL. Convex provides it.
# ZIPWIKI_WORKER_SECRET must match the Fly dev secret.
# The webhook name the code reads is STRIPE_WEBHOOK_SECRET.

SITE_URL=https://dev.zipwiki.ai
WEB_ORIGIN=https://dev.zipwiki.ai,https://zipwiki-web-dev.vercel.app,http://localhost:5173
# Invite-only beta on this deployment (also inferred from SITE_URL).
BETA_ACCESS_MODE=invite
AUTH_EMAIL="ZipWiki <noreply@zipwiki.ai>"
AUTH_ADMIN_EMAILS=steve@neoware.io,admin@neoware.io
AUTH_RESEND_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZIPWIKI_WORKER_SECRET=
ZIPWIKI_API_URL=https://api-dev.zipwiki.ai
