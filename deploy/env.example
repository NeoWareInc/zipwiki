ZIPWIKI_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# Later (new projects — not zipcodex.ai):
CONVEX_SITE_URL=
ZIPWIKI_WORKER_SECRET=
ANTHROPIC_API_KEY=
LLAMA_CLOUD_API_KEY=
