{
  "name": "@zipwiki/api-client",
  "private": true,
  "version": "0.1.0",
  "description": "Shared ZipWiki hosted API client (auth login, client-config, CLI env)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@zipwiki/typescript-config": "workspace:*",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
